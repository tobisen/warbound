{
  "name": "warcraft-2-tribute",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "assets:export": "node scripts/export-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "audio:export": "python3 scripts/export-audio.py && python3 scripts/export-wildlife-audio.py && python3 scripts/export-material-audio.py && python3 scripts/export-voice-manifest.py",
    "preview": "vite preview",
    "test:unit": "node scripts/test-unit.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
